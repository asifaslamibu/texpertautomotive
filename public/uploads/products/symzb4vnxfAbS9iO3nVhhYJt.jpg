        <datalist id="search_suggestions"></datalist>

<script type="text/javascript">$(document).ready(function(){var typeaheadTimer;var typeaheadTimeInterval=100;var e_source='load';$('form input[list=search_suggestions]').on('keydown',function(e){if(typeof e.key=='undefined'||e.key=='Enter'){e_source='list';}else{e_source='input';}});$('form input[list=search_suggestions]').on('input',function(e){if(e.originalEvent.inputType=='insertReplacementText'){e_source='list';}if(e_source=='list'||e_source==null){$(e.target).closest('form').submit();return;}clearTimeout(typeaheadTimer);e_source=null;var query=$(this).val();if(typeof query=='undefined'||query==''){$('datalist#search_suggestions').html("");return;}typeaheadTimer=setTimeout(typeahead,typeaheadTimeInterval,query);});});function typeahead(query){$.ajax({type:"POST",url:'/search/typeahead',data:JSON.stringify({query:query}),contentType:"application/json; charset=utf-8",success:function(data){$('datalist#search_suggestions').html(data);},});}</script>

