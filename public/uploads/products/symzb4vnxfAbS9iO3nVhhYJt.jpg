<script>$("button.noRedirect").click(function(e){setCookie();});$("div.modal#UScustomer").blur(function(){setCookie();});function setCookie(){var d=new Date();d.setTime(d.getTime()+(4*7*24*60*60*1000));document.cookie="ifVisitorNeedRedirect=false; expires="+d.toUTCString()+";path=/";}</script>
