  <script type="text/javascript">
        P.when('A').execute(function(A) {
            if (typeof window.agPopOverCallbackHandle === 'undefined') {
                A.on("a:popover:show:NEW_1", function(data) {
                    if ("false" === "true") {
                        A.ajax("https://fls-na.amazon.com/1/action-impressions/1/OE/amazon-global/action/amazon_global_shipmsg_:activated_popover?marketplaceId=ATVPDKIKX0DER&requestId=SSBZVAPXX93F5WG00DP0&session=146-4581552-9799605", { method: "get" });
                    }
                    
                    if ("true" === "true") {
