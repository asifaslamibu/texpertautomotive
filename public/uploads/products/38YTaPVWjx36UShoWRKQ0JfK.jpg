                    if (!pqv) {
                        P.register("pqv", function () {
                            return {
                                overlayType: 'desktop'
                            };
                        });
                    }
                });
            }));</script>         <h1 id="pqv-title"> Product Summary: UEi Test Instruments PDT650 Folding Pocket Digital Thermometer,Yellow </h1>    <p id="pqv-byline">From UEi Test Instruments</p>               <div class="a-section a-spacing-medium">  <p id="pqv-ratings" data-target="#averageCustomerReviews_feature_div" class="a-spacing-none">  4.7 out of 5 stars, 6,704 ratings </p> <span class="a-declarative" data-action="pqv-reviews-action" data-pqv-reviews-action="{}"> <a id="pqv-reviews" data-target="#customer-reviews_feature_div" class="a-link-normal" href="?ref=dp_product_quick_view#customer-reviews_feature_div"> Customer reviews </a> </span>   <p id="pqv-bought-in-last-month" data-target="#socialProofingAsinFaceout_feature_div" class="a-spacing-none">300+ bought in past week</p>  </div>        <div class="a-section a-spacing-medium"> <h2 id="pqv-price"> Price </h2>               <p class="a-spacing-small">              <span class="a-text-bold"> One-time purchase: PKR 8,037.81 </span>                  </p>                                                              <p class="a-text-italic"> <span class="a-declarative" data-action="pqv-buybox-action" data-pqv-buybox-action="{}"> <a id="pqv-buybox" data-target="#buybox" class="a-link-normal" href="?ref=dp_product_quick_view#buybox"> Purchasing options </a> </span> </p>                <p class="a-text-italic"> <span class="a-declarative" data-action="pqv-buying-options-action" data-pqv-buying-options-action="{}"> <a id="pqv-buying-options" data-target="#dynamic-aod-ingress-box" class="a-link-normal" href="?ref=dp_product_quick_view#dynamic-aod-ingress-box"> Other sellers </a> </span> </p> <p class="a-text-italic"> <span class="a-declarative" data-action="pqv-unqualified-buybox-action" data-pqv-unqualified-buybox-action="{}"> <a id="pqv-unqualified-buybox" data-target="#unqualifiedBuyBox" class="a-link-normal" href="?ref=dp_product_quick_view#unqualifiedBuyBox"> Other sellers </a> </span> </p>  </div>         <div id="pqv-feature-bullets" data-target="#featurebullets_feature_div" class="a-section a-spacing-medium"> <h2 id="pqv-feature-bullets-heading">About this Item</h2> <ul class="a-unordered-list a-vertical">  <li><span class="a-list-item">Made in China</span></li>  </ul> </div>           <div id="pqv-description" data-target="#productDescription_feature_div" class="a-section a-spacing-medium">  <h2 id="pqv-description-heading">Product Description</h2>   <div>
                    Product Description  </div>
              <div>
                    The PDT650 is a rugged Pocket Thermometer featuring an extended temperature range, built-in magnetic mount, folding temperature probe and a large easy-to-read display. The PDT650 provides reliable and accurate measurements in demanding environments. They are perfect for HVAC, refrigeration and food service areas, or anywhere Temperature monitoring is critical.  </div>
                <div>
                    From the Manufacturer  </div>
              <div>
                    UEi Test Instruments has over 50 years’ experience designing and manufacturing a broad range of award-winning, industry-leading Test and Measurement Tools. Professionals recognize the UEi brand for quality and innovative features designed to solve real-world problems. UEi backs its products with dedicated technical support, service and repair teams.  </div>
               </div>                        <div class="a-section a-spacing-medium"> <h2 id="pqv-options-available">Options Available</h2>    <h3>Style</h3> <ul class="a-unordered-list a-vertical">  <li><span class="a-list-item"> Digital Thermometer </span></li>  </ul>  <span class="a-declarative" data-action="pqv-twister-action" data-pqv-twister-action="{}"> <a id="pqv-twister" data-target="#twister-plus-inline-twister,#twister" class="a-link-normal" href="?ref=dp_product_quick_view#twister"> Browse all available options </a> </span> </div>              <div id="pqv-important-information" data-target="#importantInformation_feature_div" class="a-section a-spacing-medium"> <h2 id="pqv-important-information-heading">Important Information</h2>    <h3>Directions</h3>    <p>Use Auto Power Off to save battery life. </p>       <h3>Proposition 65 Warning for California Consumers</h3>   <p>WARNING:  Cancer -  <a class="a-link-normal" href="https://www.P65Warnings.ca.gov?ref=dp_product_quick_view">www.P65Warnings.ca.gov </a></p>    </div>          <div id="pqv-documents" data-target="#productDocuments_feature_div" class="a-section a-spacing-medium"> <h2 id="pqv-documents-heading">Product Guidance & Documents</h2>    <p> <a href="https://m.media-amazon.com/images/I/81wLZb4kJTL.pdf?ref=dp_product_quick_view"
                       rel="nofollow"
                       target="_blank"
