                 data-csa-c-type="widget" data-csa-c-content-id="maplePriceblockAmabot"
                 data-csa-c-slot-id="maplePriceblockAmabot_feature_div" data-csa-c-asin="B004WE73N2"
                 data-csa-c-is-in-initial-active-row="false">
